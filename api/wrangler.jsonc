{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aknotes-local",
      "database_id": "local-only",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "production": {
      "name": "api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aknotes-prod",
          "database_id": "d675df89-0a3c-4fca-bb4a-fdddc4bd5018",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
