{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aknotes-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aknotes-local",
      "database_id": "local-only",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "aknotes-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aknotes-preview",
          "database_id": "30039c2f-e142-442d-9973-752f9ff1978f",
          "migrations_dir": "migrations",
          "remote": true,
        },
      ],
    },
    "production": {
      "name": "aknotes-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aknotes-prod",
          "database_id": "d675df89-0a3c-4fca-bb4a-fdddc4bd5018",
          "migrations_dir": "migrations",
          "remote": true,
        },
      ],
    },
  },
}
